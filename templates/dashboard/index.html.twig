                            </tbody>
                        </table>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-6 col-lg-4">
            <a
                    class="card border-primary"
                    href="https://github.com/sponsors/kevinpapst"
                    target="_blank" rel="noopener" aria-label="Sponsor Tabler!"
                    style="background: color-mix(in srgb, var(--tblr-primary) 4%, var(--tblr-bg-surface))"
            >
                {{ source('@public_path'~asset('images/become-sponsor.svg')) }}
                <div class="card-body d-flex flex-column justify-content-center p-5">
                    <div class="row">
                        <div class="col-7 offset-5 text-primary">
                            <div class="h1 text-uppercase">Help Tabler Grow and Thrive</div>
                            <p class="h3 fw-normal">Sponsor Tabler and help us make a difference!</p>
                            <div class="mt-4">
                                {{- button('heart', {
                                    buttonType : 'button',
                                    class : 'w-100 pe-none text-pink',
                                    title : 'Become a Sponsor',
                                    combined : true,
                                }, 'button') -}}
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            {% set items = [
                {
                    network : 'Instagram',
                    visitors : '3,550',
                    progress : 71,
                },
                {
                    network : 'Twitter',
                    visitors : '1,798',
                    progress : 35.96,
                },
                {
                    network : 'Facebook',
                    visitors : '1,245',
                    progress : 24.9,
                },
                {
                    network : 'TikTok',
                    visitors : '986',
                    progress : 19.72,
                },
                {
                    network : 'Pinterest',
                    visitors : '854',
                    progress : 17.08,
                },
                {
                    network : 'VK',
                    visitors : '650',
                    progress : 13,
                },
                {
                    network : 'Pinterest',
                    visitors : '420',
                    progress : 8.4,
                },
            ] %}

            {% embed '@Tabler/embeds/card.html.twig' with {margin_bottom : 0, use_body : false} %}
                {% from '@Tabler/components/progress_bar.html.twig' import progress_bar %}
                {% block box_title %}Social Media Traffic{% endblock %}
                {% block box_body_before %}
                    <table class="table card-table table-vcenter">
                        <thead>
                        <tr>
                            <th>Network</th>
                            <th colspan="2">Visitors</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.network }}</td>
                                <td>{{ item.visitors }}</td>
                                <td class="w-50">
                                    {{ progress_bar({current : item.progress, max : 100, min : 0}, {progressSize : 'progress-xs'}) }}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-12 col-lg-8">
            {% embed '@Tabler/embeds/card.html.twig' with {margin_bottom : 0, use_body : false} %}
            {% from '@Tabler/components/progress_bar.html.twig' import progress_bar %}
            {% block box_title %}Tasks{% endblock %}
            {% block box_body_before %}
            <div class="table-responsive">
                <table class="table table-selectable card-table table-vcenter">
                    <tbody>
                    {% for index, contributor in topContributors %}
                        {% set done = random(1) is same as 1 %}
                        {% set tasks = random(10) %}
                        {% set tasksDone = random(tasks) %}
                        <tr>
                            <td class="w-1 pe-0">
                                <input
                                        type="checkbox"
                                        {% if done %}checked{% endif %}
